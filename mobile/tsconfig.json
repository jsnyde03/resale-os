{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": false,
    "paths": { "@engine/*": ["../src/*"] }
  },
  "include": ["**/*.ts", "**/*.tsx", "../src/core/**/*.ts", "../src/scoring/**/*.ts", "../src/domain/**/*.ts"]
}
