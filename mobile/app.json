{
  "expo": {
    "name": "Resale OS",
    "slug": "resale-os",
    "scheme": "resaleos",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.jasonsnyder.resaleos",
      "infoPlist": {
        "UIFileSharingEnabled": true,
        "LSSupportsOpeningDocumentsInPlace": true
      }
    },
    "plugins": ["expo-router"]
  }
}
