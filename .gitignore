node_modules/
dist/
.next/
out/
coverage/
*.log
.env
.env.local
data/*.db
data/backups/
# ⛔ An EXPORT carries `config`, and config carries `tax_profile`. The repo
# is public and GitHub keeps objects fetchable by SHA, so a single `git add -A`
# is unrecoverable. `cli export` defaults into `data/`; these cover a --to=
# that lands anywhere else. B56 cost a whole fresh repo for this exact class.
data/*.json
*-export.json
data/*.db-journal
data/*.db-wal
data/*.db-shm
.DS_Store

# Next.js. next-env.d.ts and the tsbuildinfo are generated on every build.
next-env.d.ts
*.tsbuildinfo

# Expo app
mobile/node_modules/
mobile/.expo/
mobile/.expo-export-check/
# The Hermes binary the CI lanes pin. `mobile/.gitignore` already covers the
# generated `ios/` and `android/` projects; this one is fetched beside them.
mobile/hermes-ios.tar.gz
