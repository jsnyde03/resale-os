{
  "name": "resale-os",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Private resale intelligence and capital management system.",
  "engines": {
    "node": ">=22.5.0"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit && tsc --noEmit -p mobile/tsconfig.json",
    "check": "npm run lint:bytes && npm run lint:imports && npm run lint:phone && npm run lint:plan && npm run typecheck && npm run test",
    "db:migrate": "tsx src/db/migrate.ts",
    "lint:bytes": "node scripts/check-source-bytes.mjs",
    "lint:imports": "node scripts/check-import-direction.mjs",
    "lint:phone": "node scripts/check-phone-bundle.mjs",
    "lint:plan": "node scripts/check-plan.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^3.2.4"
  },
  "dependencies": {
    "@noble/hashes": "^2.4.0",
    "zod": "^4.5.4"
  }
}
